{
  "name": "ehr-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm --prefix infra run check",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/dsql-signer": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "hono": "^4.13.14",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@hono/node-server": "^1.19.5",
    "@types/aws-lambda": "^8.10.155",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
