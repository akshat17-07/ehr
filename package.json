    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.5",
    "@types/aws-lambda": "^8.10.155",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
